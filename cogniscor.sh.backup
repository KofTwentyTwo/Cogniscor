#!/bin/bash

#
# Cogniscor - Company Research & Analysis Tool
# Friendly shell script wrapper
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR_PATH="${SCRIPT_DIR}/target/cogniscor-1.0-SNAPSHOT.jar"

# Function to print colored output
print_header() {
    echo -e "${CYAN}"
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║                      COGNISCOR                             ║"
    echo "║           Company Research & Analysis Tool                 ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

print_error() {
    echo -e "${RED}❌ Error: $1${NC}" >&2
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

# Function to check if JAR exists
check_jar() {
    if [ ! -f "$JAR_PATH" ]; then
        print_error "JAR file not found at: $JAR_PATH"
        echo ""
        print_info "Building the project..."
        cd "$SCRIPT_DIR"
        if mvn clean package -q; then
            print_success "Build complete!"
            echo ""
        else
            print_error "Build failed. Please check the error messages above."
            exit 1
        fi
    fi
}

# Function to check Java version
check_java() {
    if ! command -v java &> /dev/null; then
        print_error "Java is not installed or not in PATH"
        echo "Please install Java 17 or higher"
        exit 1
    fi
    
    JAVA_VERSION=$(java -version 2>&1 | awk -F '"' '/version/ {print $2}' | cut -d'.' -f1)
    if [ "$JAVA_VERSION" -lt 17 ]; then
        print_error "Java 17 or higher is required (found Java $JAVA_VERSION)"
        exit 1
    fi
}

# Function to show usage
show_usage() {
    print_header
    echo "Usage: $0 [OPTIONS] <website-url>"
    echo ""
    echo "Arguments:"
    echo "  <website-url>     Company's official website URL"
    echo ""
    echo "Options:"
    echo "  -h, --help        Show this help message"
    echo "  -v, --verbose     Enable verbose logging"
    echo "  -o, --output DIR  Output directory (default: ./data)"
    echo "  --setup           Run interactive setup wizard"
    echo "  --build           Force rebuild before running"
    echo "  --version         Show version information"
    echo ""
    echo "First Time Setup:"
    echo "  $0 --setup"
    echo ""
    echo "Examples:"
    echo "  $0 \"https://github.com\""
    echo "  $0 \"https://stripe.com\""
    echo "  $0 \"notion.so\""
    echo "  $0 -v \"https://www.google.com\""
    echo "  $0 --output ./research \"https://microsoft.com\""
    echo ""
    echo "Popular Companies to Try:"
    echo "  • https://github.com"
    echo "  • https://stripe.com"
    echo "  • https://notion.so"
    echo "  • https://figma.com"
    echo "  • https://vercel.com"
    echo "  • https://openai.com"
    echo ""
    echo "Note: Company name is automatically detected from the website!"
    echo "      AI is recommended for accurate identification and verification."
    echo ""
}

# Function to show version
show_version() {
    print_header
    cd "$SCRIPT_DIR"
    java -jar "$JAR_PATH" --version 2>/dev/null || echo "Version 1.0.0"
}

# Parse options
FORCE_BUILD=false
RUN_SETUP=false
JAR_ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_usage
            exit 0
            ;;
        --version)
            check_jar
            show_version
            exit 0
            ;;
        --setup)
            RUN_SETUP=true
            JAR_ARGS+=("$1")
            shift
            ;;
        --build)
            FORCE_BUILD=true
            shift
            ;;
        -v|--verbose)
            JAR_ARGS+=("$1")
            shift
            ;;
        -o|--output)
            JAR_ARGS+=("$1")
            if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
                JAR_ARGS+=("$2")
                shift
            fi
            shift
            ;;
        -*)
            print_error "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
        *)
            JAR_ARGS+=("$1")
            shift
            ;;
    esac
done

# If running setup, we don't need other args
if [ "$RUN_SETUP" = true ]; then
    # Setup mode - let Java handle all UI
    true
elif [ ${#JAR_ARGS[@]} -eq 0 ]; then
    # No arguments provided
    show_usage
    exit 0
elif [ ${#JAR_ARGS[@]} -lt 1 ]; then
    # Not enough arguments for analysis
    print_error "Website URL is required"
    echo ""
    echo "Usage: $0 <website-url>"
    echo "Example: $0 https://github.com"
    echo ""
    echo "Or run setup: $0 --setup"
    echo "Try: $0 --help for more information"
    exit 1
fi

# Main execution - Java TUI handles all output

# Check Java
check_java

# Force build if requested
if [ "$FORCE_BUILD" = true ]; then
    print_info "Rebuilding project..."
    cd "$SCRIPT_DIR"
    if mvn clean package -q; then
        print_success "Build complete!"
        echo ""
    else
        print_error "Build failed"
        exit 1
    fi
fi

# Check/build JAR
check_jar

# If running setup, just run it
if [ "$RUN_SETUP" = true ]; then
    cd "$SCRIPT_DIR"
    java -jar "$JAR_PATH" --setup
    exit $?
fi

# Extract website URL for output message
WEBSITE_URL="${JAR_ARGS[0]}"

echo -e "${BLUE}🌐 Analyzing website:${NC} $WEBSITE_URL"
echo -e "${CYAN}🤖 Company name will be automatically detected${NC}"
echo ""
print_warning "This may take 30-90 seconds (AI identification + verification)..."
echo ""

# Run the application
cd "$SCRIPT_DIR"
if java -jar "$JAR_PATH" "${JAR_ARGS[@]}"; then
    echo ""
    print_success "Analysis complete!"
    echo ""
    
    # Try to extract company name from output or use domain
    # Look for "Identified Company:" in the output
    COMPANY_NAME=$(echo "$WEBSITE_URL" | sed 's/https\?:\/\///' | sed 's/www\.//' | cut -d'/' -f1 | cut -d'.' -f1)
    SANITIZED_NAME=$(echo "$COMPANY_NAME" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]._-' | tr ' ' '_')
    OUTPUT_DIR="./data/${SANITIZED_NAME}"
    
    echo -e "${GREEN}📁 Results saved to:${NC}"
    echo "   $OUTPUT_DIR"
    echo ""
    echo -e "${GREEN}📄 View reports:${NC}"
    echo "   cat ${OUTPUT_DIR}/reports/executive_summary.md"
    echo "   cat ${OUTPUT_DIR}/reports/detailed_report.md"
    echo ""
    
    # Offer to open the report
    if command -v open &> /dev/null; then
        # macOS
        echo -e "${CYAN}💡 Tip: Open in default editor with:${NC}"
        echo "   open ${OUTPUT_DIR}/reports/executive_summary.md"
    elif command -v xdg-open &> /dev/null; then
        # Linux
        echo -e "${CYAN}💡 Tip: Open in default editor with:${NC}"
        echo "   xdg-open ${OUTPUT_DIR}/reports/executive_summary.md"
    fi
    echo ""
else
    exit_code=$?
    echo ""
    print_error "Analysis failed with exit code $exit_code"
    echo ""
    print_info "Check logs/cogniscor.log for details"
    exit $exit_code
fi
